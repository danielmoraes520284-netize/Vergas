<Window x:Class="BimBlaster.Vergas.VergasWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI"
        Background="{StaticResource WindowBackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,14">
            <Grid>
                <TextBlock x:Name="TitleText" Style="{StaticResource PluginTitleStyle}" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Width="30" Height="30" CornerRadius="7" Background="{StaticResource BrandTealBrush}">
                        <TextBlock Text="B" Foreground="White" FontWeight="Bold" FontSize="18"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="15"
                               Foreground="{StaticResource TextPrimaryBrush}">
                        <Run Text="BIM" FontWeight="Bold"/><Run Text=" BLASTER" FontWeight="Normal"/>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource PanelCardStyle}" Margin="0,20,0,0">
            <StackPanel>
                <TextBlock x:Name="SelectionLabel" Style="{StaticResource SectionLabelStyle}"/>
                <RadioButton x:Name="ModeWindowRadio" IsChecked="True" GroupName="mode" Margin="0,4,0,0">
                    <StackPanel>
                        <TextBlock x:Name="ModeWindowText" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock x:Name="ModeWindowHint" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="ModePickRadio" GroupName="mode" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock x:Name="ModePickText" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock x:Name="ModePickHint" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </RadioButton>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="CancelButton" Style="{StaticResource SecondaryButtonStyle}" IsCancel="True" Click="Cancel_Click"/>
            <Button x:Name="RunButton" Style="{StaticResource PrimaryButtonStyle}" IsDefault="True" Margin="10,0,0,0" Click="Run_Click"/>
        </StackPanel>
    </Grid>
</Window>